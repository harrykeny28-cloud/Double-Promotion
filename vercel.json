{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/assets/(?<path>.*)",
      "dest": "/assets/$path"
    },
    {
      "src": "/favicon.svg",
      "dest": "/favicon.svg"
    },
    {
      "src": "/images/(?<path>.*)",
      "dest": "/images/$path"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
